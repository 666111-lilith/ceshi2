  m_Name: 
  m_EditorClassIdentifier: 
  notes: "PALWORKS \xB7 \u5361\u7247\u573A\u666F\u539F\u578B\nPlay \u540E\u7528 WASD
    \u79FB\u52A8\u3002\u4EBA\u7269\u5728 X/Z \u5730\u9762\u4E0A\u8D70\u52A8\uFF0CY
    \u4E3A\u9AD8\u5EA6\u3002\n\u573A\u666F\u4E2D\u6240\u6709\u73AF\u5883\u7269\u4EF6\u5747\u4E3A\u53EF\u7F16\u8F91\u5361\u7247\uFF1B\u78B0\u649E\u4F53\u653E\u5728\u72EC\u7ACB\u5206\u7EC4\u3002\nCamera\uFF1A\u6B63\u4EA4\u3001\u6D45\u4FEF\u89C6\u3002Environment\uFF1ACult
    of the Lamb \u539F\u7D20\u6750 + URP \u53CC\u9762\u88C1\u526A\u3002\n\u4E0D\u5305\u542B\u6218\u6597\u3001\u8868\u6F14\u5C42\u3001\u6295\u5F71\u89E3\u8C1C\u6216\u5347\u7EA7\u7CFB\u7EDF\u3002\n\u76F4\u63A5\u79FB\u52A8
    / \u590D\u5236\u573A\u666F\u91CC\u7684\u5361\u7247\u5373\u53EF\u7EE7\u7EED\u5E03\u7F6E\uFF1B\u4E0D\u4F1A\u5728\u8FD0\u884C\u65F6\u91CD\u5EFA\u573A\u666F\u3002"
  walkableX: {x: -9, y: 9}
  walkableZ: {x: -1.8, y: 1.8}
